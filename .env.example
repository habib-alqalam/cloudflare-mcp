# cloudflare-mcp configuration
# Copy this file to `.env` and fill in your values. Never commit the real .env.

# Required. Create at: https://dash.cloudflare.com/profile/api-tokens
# Recommended scopes: Zone > DNS > Edit, Zone > Zone > Read, Zone > Cache Purge > Purge.
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Optional. If set, cf_list_zones is scoped to this account.
# Find it in the Cloudflare dashboard URL or on any zone's Overview page.
CLOUDFLARE_ACCOUNT_ID=
